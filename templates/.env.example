# .env.example — copier en .env sur le VPS (JAMAIS commité).
# Exemple concret : danschool. Adapter les valeurs par projet.
#
# NB : ce .env est géré via les secrets d'org ENV_PROD / ENV_STAGING et déposé
# sur le VPS par le pipeline à chaque déploiement (voir docs/secrets.md).

# ── Images GHCR (pipeline) ───────────────────────────────────────────────────
REGISTRY=ghcr.io
IMAGE_API=danylog243/danschool-api
IMAGE_WEB=danylog243/danschool-web
IMAGE_TAG=latest        # placeholder de secours ; deploy.sh exporte le vrai tag

# ── Application ───────────────────────────────────────────────────────────────
DOMAIN=app.danschool.app
PRIMARY_DOMAINS=app.danschool.app,danschool.app
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=https://app.danschool.app
APP_URL=https://app.danschool.app
PUBLIC_APP_BASE_DOMAIN=danschool.app
PASSWORD_RESET_TTL_MIN=60

# ── Base de données ───────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=danschool
DB_USER=danschool
DB_PASSWORD=CHANGER_mot_de_passe_fort
DB_SYNC=false           # prod/staging : le schéma est piloté par les migrations Umzug

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGER_openssl_rand_hex_32
REFRESH_SECRET=CHANGER_openssl_rand_hex_32
JWT_EXPIRES_IN=24h
REFRESH_EXPIRES_IN=30d

# ── SMTP (vide = envoi simulé) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DANSCHOOL <no-reply@danschool.app>

# ── Déploiement (optionnel) ───────────────────────────────────────────────────
# COMPOSE_PROJECT_NAME : à définir en STAGING pour isoler du prod (ex. danschool-staging)
# COMPOSE_PROJECT_NAME=danschool-staging
#
# HEALTH_URL : forcer l'URL du healthcheck de déploiement.
#   - PROD    : laisser vide (health via Caddy, calculé depuis DOMAIN).
#   - STAGING : pointer l'API exposée en local :
# HEALTH_URL=http://localhost:3001/api/v1/health
